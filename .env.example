# Copy to .env and adjust as needed
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
DB_FILE=./database/pos.db
NODE_ENV=development

# --- Cloud database (Turso / libSQL) ------------------------------------
# Leave both blank to use a local SQLite file (DB_FILE above) - this is the
# default for the till PC and keeps the app fully offline.
# Set both to point at a Turso database instead - required for a Vercel/
# serverless deployment, since it has no persistent local disk.
# Free database: https://turso.tech -> `turso db create nox-lounge` ->
# `turso db show nox-lounge --url` and `turso db tokens create nox-lounge`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- M-Pesa STK Push (Daraja) -------------------------------------------
# Get free sandbox keys at https://developer.safaricom.co.ke
# ("Lipa Na M-Pesa Sandbox" app on your account). Needs internet access;
# everything else in the app keeps working without these set.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test shortcode + passkey (public test values from Safaricom's docs):
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be a real public HTTPS URL for Safaricom to push results to.
# Optional: the app polls Safaricom directly (stkpushquery) as the primary
# path, so this can stay blank on a machine with no public URL (e.g. via ngrok).
MPESA_CALLBACK_URL=

# --- Cloud sync / remote reporting --------------------------------------
# Offline-first: sales always save locally first. Whenever the till has
# internet, newly-completed sales are pushed to this webhook (a free
# Google Sheet + Apps Script by default - see INSTALL.md "Remote reporting").
# Blank = fully disabled, no attempts, no errors.
SYNC_WEBHOOK_URL=
SYNC_WEBHOOK_TOKEN=
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=25
